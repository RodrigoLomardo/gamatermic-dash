# Copie para .env e preencha. NUNCA commite o .env. Gere segredos com: openssl rand -base64 48
GAMA_ENV=prod
GAMA_DATABASE_URL=postgresql+asyncpg://gama:CHANGE_ME@db:5432/gamatermic
POSTGRES_USER=gama
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gamatermic

# JWT (HS256): >= 32 caracteres. Rotacao: ver docs/runbooks/rotacao-de-segredos.md
GAMA_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
GAMA_JWT_KID=k1
# Fernet (cifra de segredos de conectores): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GAMA_FERNET_KEY=CHANGE_ME
GAMA_PASSWORD_PEPPER=

# Dominio publico (Caddy emite TLS automaticamente) e CORS (mesma origem: pode ficar so o dominio)
SITE_ADDRESS=dash.suaempresa.com.br
GAMA_CORS_ORIGINS=["https://dash.suaempresa.com.br"]
GAMA_COOKIE_SECURE=true
GAMA_DOCS_ENABLED=false
GAMA_RUN_WORKER_INPROCESS=false
GAMA_FRONTEND_VERSION=0.1.0

# Admin inicial (usado por `python -m app.cli bootstrap`)
GAMA_ADMIN_EMAIL=admin@suaempresa.com.br
GAMA_ADMIN_PASSWORD=CHANGE_ME_frase_longa

# Backup (criptografado com AES-256). Guarde a frase FORA do servidor.
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_RETENTION_DAYS=14
# Opcional: destino externo via rclone (ex.: b2:gamatermic-backups)
BACKUP_RCLONE_REMOTE=

